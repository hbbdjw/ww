      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="tearDown-汇总与可选清理">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="汇总（前缀总量/净增/节点分布）+ 可选分批清理" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper
def prefix = vars.get(&apos;KEY_PREFIX&apos;)
def base = &apos;http://&apos; + vars.get(&apos;HOST&apos;) + &apos;:&apos; + vars.get(&apos;NODE_PORTS&apos;).split(&apos;,&apos;)[0].trim()
def get = { String path -&gt;
    def c = new URL(base + path).openConnection()
    c.requestMethod = &apos;GET&apos;
    c.connectTimeout = 10000
    c.readTimeout = 60000
    int code = c.responseCode
    String body = (code == 200) ? c.inputStream.getText(&apos;UTF-8&apos;) : &apos;&apos;
    return [code, body]
}
def delete = { String key -&gt;
    def c = new URL(base + &apos;/cache/&apos; + key).openConnection()
    c.requestMethod = &apos;DELETE&apos;
    c.connectTimeout = 10000
    c.readTimeout = 30000
    return c.responseCode
}
def out = new StringBuilder()
// 1) 前缀总量与净增（相对 setUp 基线）
def (tCode, tBody) = get(&apos;/cache/keys?prefix=&apos; + prefix + &apos;-&amp;limit=1&apos;)
long total = -1L
if (tCode == 200) {
    total = new JsonSlurper().parseText(tBody).total
}
long baseline = props.containsKey(&apos;ldBaselineTotal&apos;) ? Long.parseLong(props.get(&apos;ldBaselineTotal&apos;).toString()) : 0L
out.append(&apos;prefix=&apos;).append(prefix).append(&apos; total=&apos;).append(total).append(&apos; baseline=&apos;).append(baseline).append(&apos; netNew=&apos;).append(total - baseline)
// 2) 节点分布（打印到 jmeter.log 与采样响应）
def (sCode, sBody) = get(&apos;/rt/cache/node-stats&apos;)
if (sCode == 200) {
    def nodes = new JsonSlurper().parseText(sBody).nodes
    nodes.each { nd -&gt; out.append(&apos; | &apos;).append(nd.nodeId).append(&apos; &apos;).append(nd.cacheActual).append(&apos; keys=&apos;).append(nd.keyCount) }
    log.info(&apos;[cache-loadtest] 最终汇总: &apos; + out.toString())
}
// 3) 可选清理：CLEANUP=true 时分批删除前缀全部 key（绕过 /keys 前缀删除的 1 万上限）
if (&apos;true&apos;.equalsIgnoreCase(vars.get(&apos;CLEANUP&apos;))) {
    long deleted = 0L
    int guard = 0
    while (guard++ &lt; 2000) {
        def (kCode, kBody) = get(&apos;/cache/keys?prefix=&apos; + prefix + &apos;-&amp;limit=10000&apos;)
        if (kCode != 200) {
            out.append(&apos; | cleanupError=&apos;).append(kCode)
            break
        }
        def keys = new JsonSlurper().parseText(kBody).keys.collect { it.key }
        if (keys.isEmpty()) {
            break
        }
        keys.each { k -&gt; if (delete(k) == 204) { deleted++ } }
    }
    out.append(&apos; | cleanupDeleted=&apos;).append(deleted)
    log.info(&apos;[cache-loadtest] 清理完成: &apos; + out.toString())
}
SampleResult.setResponseData(out.toString(), &apos;UTF-8&apos;)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
