        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="随机 key + 随机节点" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def ctr = props.get(&apos;ldCounter&apos;)
long max = (ctr == null) ? 0L : ctr.get()
long n = (max &gt;= 1) ? (1L + (long) (Math.random() * max)) : 1L
vars.put(&apos;KEY&apos;, vars.get(&apos;KEY_PREFIX&apos;) + &apos;-&apos; + n)
def ports = vars.get(&apos;NODE_PORTS&apos;).split(&apos;,&apos;)
vars.put(&apos;PORT&apos;, ports[(int) (Math.random() * ports.length)].trim())</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET-keys 管理面列举" enabled="true">
