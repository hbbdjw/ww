<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.5">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="ww-admin 集群可靠性压测" enabled="true">
      <stringProp name="TestPlan.comments">
【测试场景】
 1. 混合读写压测 — 50 线程 × 5 分钟，60%PUT / 30%GET / 10%DEL
 2. 大数据量写入 — 100 线程斜坡启动，1KB 随机值持续写入
 3. 数据一致性验证 — 写入后从 3 节点分别读取，断言值一致
 4. TTL 过期淘汰 — 短 TTL 写入后验证过期行为
 5. 集群读扩散 — 同一 key 轮询读取，验证副本一致

【前置条件】
 - 3 节点集群已启动
 - 端口: 8081(node1) / 8082(node2) / 8083(node3)

【API 接口】
 - POST /cache/put        {&quot;key&quot;:&quot;xxx&quot;,&quot;value&quot;:&quot;xxx&quot;}
 - POST /cache/get        {&quot;key&quot;:&quot;xxx&quot;}
 - POST /cache/putExpired {&quot;key&quot;:&quot;xxx&quot;,&quot;value&quot;:&quot;xxx&quot;,&quot;ttlMillis&quot;:&quot;xxx&quot;}
 - POST /cache/remove     {&quot;key&quot;:&quot;xxx&quot;}
 - POST /cache/hset       {&quot;key&quot;:&quot;xxx&quot;,&quot;field&quot;:&quot;xxx&quot;,&quot;value&quot;:&quot;xxx&quot;}
 - POST /cache/hget       {&quot;key&quot;:&quot;xxx&quot;,&quot;field&quot;:&quot;xxx&quot;}
 - POST /cache/hgetAll    {&quot;key&quot;:&quot;xxx&quot;}
 - POST /cache/sadd       {&quot;key&quot;:&quot;xxx&quot;,&quot;members&quot;:[&quot;xxx&quot;]}
 - POST /cache/smembers   {&quot;key&quot;:&quot;xxx&quot;}
 - POST /cache/zadd       {&quot;key&quot;:&quot;xxx&quot;,&quot;score&quot;:xxx,&quot;member&quot;:&quot;xxx&quot;}
 - POST /cache/zrange     {&quot;key&quot;:&quot;xxx&quot;,&quot;start&quot;:xxx,&quot;stop&quot;:xxx}

【响应格式】
 - 成功: {&quot;type&quot;:&quot;success&quot;,&quot;code&quot;:&quot;0&quot;,&quot;data&quot;:...}
 - 失败: {&quot;type&quot;:&quot;warn&quot;,&quot;code&quot;:&quot;-1&quot;,&quot;message&quot;:&quot;...&quot;}
      </stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="压测配置变量" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="NODE1_HOST" elementType="Argument">
            <stringProp name="Argument.name">NODE1_HOST</stringProp>
            <stringProp name="Argument.value">localhost</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NODE1_PORT" elementType="Argument">
            <stringProp name="Argument.name">NODE1_PORT</stringProp>
            <stringProp name="Argument.value">8081</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NODE2_PORT" elementType="Argument">
            <stringProp name="Argument.name">NODE2_PORT</stringProp>
            <stringProp name="Argument.value">8082</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NODE3_PORT" elementType="Argument">
            <stringProp name="Argument.name">NODE3_PORT</stringProp>
            <stringProp name="Argument.value">8083</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="VALUE_SIZE" elementType="Argument">
            <stringProp name="Argument.name">VALUE_SIZE</stringProp>
