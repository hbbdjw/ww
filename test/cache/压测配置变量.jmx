            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LARGE_VALUE_SIZE" elementType="Argument">
            <stringProp name="Argument.name">LARGE_VALUE_SIZE</stringProp>
            <stringProp name="Argument.value">1024</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SHORT_TTL_MS" elementType="Argument">
