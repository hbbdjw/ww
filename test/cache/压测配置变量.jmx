        <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223: 三节点值一致性断言" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
def v1 = vars.get(&quot;node1_value&quot;)
def v2 = vars.get(&quot;node2_value&quot;)
def v3 = vars.get(&quot;node3_value&quot;)

if (v1 == null || v1 == &quot;NOT_FOUND&quot;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Node1 未读取到值&quot;)
    return
}

if (v1 != v2) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;副本不一致: Node1=${v1}  Node2=${v2}&quot;)
    return
}

if (v1 != v3) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;副本不一致: Node1=${v1}  Node3=${v3}&quot;)
    return
}

// PASS — 三节点完全一致
          </stringProp>
        </JSR223Assertion>
