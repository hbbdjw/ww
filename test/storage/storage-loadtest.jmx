            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NODE2_PORT" elementType="Argument">
            <stringProp name="Argument.name">NODE2_PORT</stringProp>
            <stringProp name="Argument.value">8082</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NODE3_HOST" elementType="Argument">
            <stringProp name="Argument.name">NODE3_HOST</stringProp>
            <stringProp name="Argument.value">127.0.0.1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
