<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="ww storage 分布式对象存储压测">
      <stringProp name="TestPlan.comments">ww 项目 runtime-server STORAGE 网关压测脚本：清空存储数据 → 施压（桶/上传/下载/查询/删除）→ 结果验证（list 翻页计数比对 + 随机下载已上传文件）。无认证，任意节点可打，网关按 placement 自动路由。</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
        <collectionProp name="Arguments.arguments">
          <elementProp name="NODE1_HOST" elementType="Argument">
            <stringProp name="Argument.name">NODE1_HOST</stringProp>
            <stringProp name="Argument.value">127.0.0.1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NODE1_PORT" elementType="Argument">
            <stringProp name="Argument.name">NODE1_PORT</stringProp>
            <stringProp name="Argument.value">8081</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="NODE2_HOST" elementType="Argument">
            <stringProp name="Argument.name">NODE2_HOST</stringProp>
