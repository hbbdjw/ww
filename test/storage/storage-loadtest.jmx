            <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="断言 204/409（删除成功或桶不存在）" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def code = SampleResult.getResponseCode()
if (code != &apos;204&apos; &amp;&amp; code != &apos;409&apos;) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;期望 204(删除)/409(不存在)，实际 &apos; + code + &apos;: &apos; + SampleResult.getResponseDataAsString())
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="等待删除广播生效 2000ms" enabled="true">
          <stringProp name="ConstantTimer.delay">2000</stringProp>
        </ConstantTimer>
        <hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="创建所有测试桶循环（BUCKET_COUNT 次）" enabled="true">
