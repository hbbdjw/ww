          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="创建测试桶 PUT /storage/${BUCKET}_${CREATE_B_IDX}" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">10000</intProp>
