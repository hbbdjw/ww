              <stringProp name="script">def digits = (vars.get(&quot;KEY_DIGITS&quot;) as int)
def total = (vars.get(&quot;FILE_COUNT&quot;) as int)
def deleted = (vars.get(&quot;DELETE_COUNT&quot;) as int)
def n = new Random().nextInt(total - deleted) + deleted + 1
vars.put(&quot;RAND_KEY_VERIFY&quot;, String.format(&quot;%0&quot; + digits + &quot;d&quot;, n))
def bucketCount = (vars.get(&quot;BUCKET_COUNT&quot;) as int)
def bucketIdx = ((n - 1) % bucketCount) + 1
vars.put(&quot;RAND_VERIFY_BUCKET&quot;, vars.get(&quot;BUCKET&quot;) + &quot;_&quot; + bucketIdx)</stringProp>
