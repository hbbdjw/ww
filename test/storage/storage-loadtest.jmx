          <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="统计桶序号 STATS_IDX" enabled="true">
            <stringProp name="CounterConfig.start">1</stringProp>
            <stringProp name="CounterConfig.end">${BUCKET_COUNT}</stringProp>
            <stringProp name="CounterConfig.incr">1</stringProp>
            <stringProp name="CounterConfig.name">STATS_IDX</stringProp>
            <stringProp name="CounterConfig.format"></stringProp>
            <boolProp name="CounterConfig.per_user">false</boolProp>
          </CounterConfig>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="list 翻页统计桶对象数 ${BUCKET}_${STATS_IDX}" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def host = vars.get(&quot;NODE1_HOST&quot;)
def port = vars.get(&quot;NODE1_PORT&quot;)
def bucket = vars.get(&quot;BUCKET&quot;) + &quot;_&quot; + vars.get(&quot;STATS_IDX&quot;)
def base = &quot;http://&quot; + host + &quot;:&quot; + port + &quot;/storage/&quot; + bucket
def marker = null
def total = 0L
def pages = 0
def parser = new JsonSlurper()
while (pages &lt; 100000) {
    def url = base + &quot;?maxKeys=1000&quot; + (marker != null ? &quot;&amp;marker=&quot; + marker : &quot;&quot;)
    def conn = new URL(url).openConnection()
    conn.setRequestProperty(&quot;Accept&quot;, &quot;application/json&quot;)
    conn.connectTimeout = 10000
    conn.readTimeout = 120000
    def code = conn.responseCode
    if (code != 200) {
        throw new Exception(&quot;list HTTP &quot; + code + &quot;: &quot; + url)
    }
    def json = parser.parseText(conn.inputStream.getText(&quot;UTF-8&quot;))
    total += (json.objects as List).size()
    if (!json.truncated || json.nextMarker == null) {
        break
    }
    marker = json.nextMarker
    pages++
}
synchronized (props) {
    def cur = (props.get(&quot;TOTAL_COUNT&quot;) as Long) ?: 0L
    props.put(&quot;TOTAL_COUNT&quot;, cur + total)
}
log.info(&quot;桶 &quot; + bucket + &quot; 对象数=&quot; + total)
SampleResult.setSuccessful(true)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="比对：实际文件数 vs 请求成功数" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def actual = (props.get(&quot;TOTAL_COUNT&quot;) as Long) ?: -1L
def uploadOk = (props.get(&quot;UPLOAD_OK&quot;) as Long) ?: 0L
def deleteOk = (props.get(&quot;DELETE_OK&quot;) as Long) ?: 0L
def expected = uploadOk - deleteOk
def pass = (actual &gt;= 0L) &amp;&amp; (actual == expected)
log.info(&quot;结果验证: 实际文件数=&quot; + actual + &quot;, 上传成功=&quot; + uploadOk + &quot;, 删除成功=&quot; + deleteOk + &quot;, 期望文件数=&quot; + expected + &quot;, 一致=&quot; + pass)
if (!pass) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&quot;验证失败: 实际文件数 &quot; + actual + &quot; != 期望 &quot; + expected)
} else {
    SampleResult.setResponseMessage(&quot;验证通过: 实际文件数 &quot; + actual + &quot; == 请求成功文件数 &quot; + expected)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
